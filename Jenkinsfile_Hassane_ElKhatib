pipeline {
    agent any
    environment {
        VIRTUAL_ENV = 'venv'
    }
    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        sh "python3 -m venv ${VIRTUAL_ENV}"
                    }
                    sh ". ${VIRTUAL_ENV}/bin/activate && pip install -r requirements.txt"
                }
            }
        }
        stage('Lint') {
            steps {
                sh ". ${VIRTUAL_ENV}/bin/activate && flake8 app.py"
            }
        }
        stage('Test') {
            steps {
                sh ". ${VIRTUAL_ENV}/bin/activate && python -m pytest"
            }
        }
        stage('Coverage') {
            steps {
                sh """
                    . ${VIRTUAL_ENV}/bin/activate
                    coverage run -m pytest
                    coverage report -m
                    coverage xml
                    coverage html
                """
            }
        }
        stage('Security Scan') {
            steps {
                sh """
                    . ${VIRTUAL_ENV}/bin/activate
                    bandit -r app.py
                    bandit -r app.py -f txt -o bandit-report.txt
                """
            }
        }
        stage('Deploy') {
            steps {
                echo "Deploying application..."
                sh "sh deploy.sh"
            }
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'coverage.xml, htmlcov/**, bandit-report.txt', allowEmptyArchive: true
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed.'
        }
    }
}
